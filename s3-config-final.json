{
  "name": "s3-sink-connector",
  "config": {
    "connector.class": "io.confluent.connect.s3.S3SinkConnector",
    "storage.class": "io.confluent.connect.s3.storage.S3Storage",
    "tasks.max": "1",
    "topics": "ecommerce.public.customers,ecommerce.public.products,ecommerce.public.orders,ecommerce.public.order_items,ecommerce.public.payments,ecommerce.public.carts,ecommerce.public.cart_items,ecommerce.public.shipments,ecommerce.public.inventory,ecommerce.public.warehouses",
    "s3.bucket.name": "my-data-project-kafka-raw",
    "s3.region": "us-west-2",
    "flush.size": "100",
    "rotate.interval.ms": "60000",
    "rotate.schedule.interval.ms": "60000",
    "behavior.on.null.values": "ignore",
    "format.class": "io.confluent.connect.s3.format.parquet.ParquetFormat",
    "parquet.codec": "snappy",
    "schema.compatibility": "NONE",
    "partitioner.class": "io.confluent.connect.storage.partitioner.TimeBasedPartitioner",
    "path.format": "'bronze'/YYYY/MM/dd",
    "partition.duration.ms": "86400000",
    "locale": "en-US",
    "timezone": "UTC",
    "timestamp.extractor": "Record"
  }
}
